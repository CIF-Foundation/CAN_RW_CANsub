# Build libcansub_codec.so on any Linux x86_64 with gcc (desktop or the NI Linux RT target).
# The .so needs only glibc >= 2.14 and baseline x86-64, so a desktop build runs on NI Linux RT.
#   make          -> libcansub_codec.so
#   make test     -> builds and runs test_cansub_codec (expects "ALL PASS")
#   make check    -> test build with AddressSanitizer + UBSan (desktop Linux)
#   make bench    -> builds and runs the timing benchmark
#   make dist     -> dist/: the .so + STATIC test and bench programs (run on the target without
#                    a compiler) + crosscheck.py + SHA256SUMS
CC      ?= gcc
CFLAGS  ?= -O2 -std=gnu11 -Wall -Wextra -Wpedantic -Wconversion -Wno-sign-conversion -fPIC
LDLIBS  := -lm

all: libcansub_codec.so

libcansub_codec.so: cansub_codec.c cansub_codec.h crc32_table.inc
	$(CC) $(CFLAGS) -shared -fvisibility=default -o $@ cansub_codec.c $(LDLIBS)

test_cansub_codec: test_cansub_codec.c cansub_codec.c cansub_codec.h crc32_table.inc
	$(CC) $(CFLAGS) -o $@ test_cansub_codec.c cansub_codec.c $(LDLIBS)

test: test_cansub_codec
	./test_cansub_codec

check: test_cansub_codec.c cansub_codec.c cansub_codec.h crc32_table.inc
	$(CC) -O1 -g -std=gnu11 -Wall -Wextra -fsanitize=address,undefined -fno-omit-frame-pointer \
	    -o test_cansub_codec_asan test_cansub_codec.c cansub_codec.c $(LDLIBS)
	./test_cansub_codec_asan

bench_cansub_codec: bench_cansub_codec.c cansub_codec.c cansub_codec.h crc32_table.inc
	$(CC) $(CFLAGS) -o $@ bench_cansub_codec.c cansub_codec.c $(LDLIBS)

bench: bench_cansub_codec
	./bench_cansub_codec

dist: libcansub_codec.so test_cansub_codec.c bench_cansub_codec.c crosscheck.py
	mkdir -p dist
	cp libcansub_codec.so crosscheck.py dist/
	$(CC) $(CFLAGS) -static -o dist/test_cansub_codec_static test_cansub_codec.c cansub_codec.c $(LDLIBS)
	$(CC) $(CFLAGS) -static -o dist/bench_cansub_codec_static bench_cansub_codec.c cansub_codec.c $(LDLIBS)
	cd dist && sha256sum libcansub_codec.so test_cansub_codec_static bench_cansub_codec_static crosscheck.py > SHA256SUMS

# LabVIEW Import Shared Library wizard (runs on Windows LabVIEW):
#   make wizard -> wizard/: libcansub_codec.dll (Windows x64, same 18 functions),
#                  libcansub_codec.so, cansub_codec_lv.h (header without #include, for the
#                  wizard parser), test_cansub_codec_win.exe (the 927 checks, against the DLL),
#                  SHA256SUMS.
# Cross-compiler: zig (pip install ziglang==0.13.0). Override with ZIGCC=...
ZIGCC   ?= python3 -m ziglang cc
WINFLAGS := -target x86_64-windows-gnu -O2 -std=gnu11 -Wall -Wextra -Wconversion -Wno-sign-conversion -s

wizard: libcansub_codec.so cansub_codec.c cansub_codec.h cansub_codec.def test_cansub_codec.c
	mkdir -p wizard
	$(ZIGCC) $(WINFLAGS) -shared -o wizard/libcansub_codec.dll cansub_codec.c cansub_codec.def
	$(ZIGCC) $(WINFLAGS) -o wizard/test_cansub_codec_win.exe test_cansub_codec.c wizard/cansub_codec.lib
	rm -f wizard/*.pdb wizard/*.lib
	cp libcansub_codec.so wizard/
	{ echo '/* GENERATED by "make wizard" from cansub_codec.h - do not edit. Header for the LabVIEW'; \
	  echo ' * Import Shared Library wizard: no #include, fixed-width types defined here (LabVIEW x64).'; \
	  echo ' * The function prototypes are identical to cansub_codec.h. */'; \
	  echo 'typedef unsigned char  uint8_t;'; \
	  echo 'typedef unsigned short uint16_t;'; \
	  echo 'typedef int            int32_t;'; \
	  echo 'typedef unsigned int   uint32_t;'; \
	  sed -e '/#include <stdint.h>/d' -e '/__cplusplus/,/#endif/d' cansub_codec.h; } > wizard/cansub_codec_lv.h
	cd wizard && sha256sum libcansub_codec.dll libcansub_codec.so cansub_codec_lv.h test_cansub_codec_win.exe > SHA256SUMS

clean:
	rm -rf libcansub_codec.so test_cansub_codec test_cansub_codec_asan bench_cansub_codec dist wizard

.PHONY: all test check bench dist wizard clean
